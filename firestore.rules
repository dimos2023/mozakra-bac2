rules_version = '2';

// ============================================================
//  قواعد أمان Firestore — مذكرة البرمجة والذكاء الاصطناعي
//  ------------------------------------------------------------
//  المبدأ: لا أحد يقرأ المحتوى إلا إذا كان:
//    (1) مسجّل دخول بحساب جوجل بإيميل مُوثَّق، و
//    (2) إيميله موجود في مجموعة allowlist، و
//    (3) الحقل active في وثيقته = true
//
//  الزائر غير المسجَّل يقدر يعمل *طلب انضمام* فقط (requests)،
//  ولا يرى المحتوى حتى يوافق المدرس.
//
//  الكتابة في sessions ممنوعة تمامًا من المتصفح — من seed.js فقط.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- دوال مساعدة ----------

    function isSignedIn() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email_verified == true;
    }

    function mail() {
      return request.auth.token.email.lower();
    }

    function allowDoc() {
      return get(/databases/$(database)/documents/allowlist/$(mail())).data;
    }

    function isAllowed() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/allowlist/$(mail()))
          && allowDoc().active == true;
    }

    function isTeacher() {
      return isAllowed() && allowDoc().role == 'teacher';
    }

    // ---------- قائمة المسموح لهم ----------
    // الطالب يقرأ وثيقته هو فقط (عشان يعرف دوره ومجموعته).
    // المدرس يستعرض ويعدّل ويحذف — عشان يقدر يقبل الطلبات من الموقع.
    match /allowlist/{mailId} {
      allow get:  if isSignedIn() && mailId == request.auth.token.email.lower();
      allow list: if isTeacher();

      // الإنشاء والتعديل — مع منع المدرس من إلغاء صفته عن نفسه
      // (ملحوظة: request.resource متاح في create و update فقط)
      allow create, update: if isTeacher()
                            && !(mailId == mail() && request.resource.data.role != 'teacher');

      // الحذف — request.resource يكون null هنا، فلا نلمسه إطلاقًا.
      // المدرس ممنوع من حذف نفسه حتى لا يُقفل خارج النظام.
      allow delete: if isTeacher() && mailId != mail();
    }

    // ---------- طلبات الانضمام ----------
    // أي مستخدم مسجّل دخول يقدر ينشئ طلبه هو فقط، بحالة pending.
    // لا يستطيع تغيير الحالة إلى approved — القبول من المدرس فقط.
    match /requests/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;

      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.email == mail()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly(
                         ['email','name','photo','groupId','note','status','createdAt']);

      // إعادة الإرسال بعد الرفض، أو تعديل الطلب أثناء الانتظار
      allow update: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly(
                         ['email','name','photo','groupId','note','status','createdAt']);

      // المدرس يستعرض ويقرّر ويحذف
      allow list, update, delete: if isTeacher();
    }

    // ---------- المجموعات ----------
    // الجميع (حتى غير المقبول) يقرأ الأسماء عشان يختار مجموعته في الطلب.
    match /groups/{gid} {
      allow read:  if isSignedIn();
      allow write: if isTeacher();
    }

    // ---------- ملفات المستخدمين (سجل الدخول) ----------
    match /users/{uid} {
      allow get:  if isAllowed() && (request.auth.uid == uid || isTeacher());
      allow list: if isTeacher();

      allow create: if isAllowed()
                    && request.auth.uid == uid
                    && request.resource.data.email == mail()
                    && request.resource.data.keys().hasOnly(
                         ['email','name','photo','firstLogin','lastLogin','loginCount']);

      allow update: if isAllowed()
                    && request.auth.uid == uid
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.keys().hasOnly(
                         ['email','name','photo','firstLogin','lastLogin','loginCount']);

      allow delete: if isTeacher();
    }

    // ---------- تقدّم الطالب ----------
    match /progress/{uid} {
      allow get:  if isAllowed() && (request.auth.uid == uid || isTeacher());
      allow list: if isTeacher();

      allow write: if isAllowed()
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(
                        ['completed','lastSession','updatedAt','email']);

      allow delete: if isTeacher();
    }

    // ---------- فهرس الحصص (خفيف، بلا محتوى) ----------
    // كل طالب مقبول يرى خطة الترم كاملة: الأرقام والعناوين والتواريخ
    // وحالة الفتح — عشان يعرف رايح فين. مفيش شرح ولا أسئلة هنا.
    match /sessions/{sid} {
      allow read: if isAllowed();

      // المدرس يفتح ويقفل فقط — ممنوع تعديل الفهرس نفسه من المتصفح
      allow update: if isTeacher()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['released']);

      allow create, delete: if false;
    }

    // ---------- محتوى الحصص (الشرح والرسوم والأسئلة) ----------
    // المدرس يقرأ الكل. الطالب يقرأ المفتوح فقط — والقاعدة تُطبَّق
    // على الخادم، فمحتوى الحصة المقفولة لا يصل جهازه إطلاقًا.
    //
    // ملحوظة: القواعد ليست فلترًا، فاستعلام الطالب لازم يقيّد
    // released == true وإلا يُرفض بالكامل. الكود بيعمل كده.
    match /content/{sid} {
      allow read: if isTeacher();
      allow read: if isAllowed() && resource.data.released == true;

      // نفس مفتاح الفتح مكرّر هنا حتى يعمل الاستعلام الجماعي.
      // المدرس يقلبه في الوثيقتين معًا في دفعة واحدة.
      allow update: if isTeacher()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['released']);

      allow create, delete: if false;
    }

    // ---------- إعدادات الاشتراك ----------
    // المبلغ وحساب إنستاباي وعدد الحصص في الشهر.
    // كل طالب مقبول يقرأها (ليعرف كم يدفع ولمن)، والمدرس وحده يعدّلها.
    match /config/{cfg} {
      allow read:  if isAllowed();
      allow write: if isTeacher();
    }

    // ---------- إقرارات الدفع ----------
    // الطالب يُقرّ بأنه حوّل (status = 'claimed') ولا يستطيع تأكيد نفسه.
    // التأكيد (confirmed) من المدرس وحده — لأن الموقع لا يتحقق من التحويل.
    match /payments/{pid} {
      allow read: if isTeacher();
      allow read: if isAllowed() && resource.data.uid == request.auth.uid;

      allow create: if isAllowed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == mail()
                    && request.resource.data.status == 'claimed'
                    && request.resource.data.keys().hasOnly(
                         ['uid','email','name','cycle','amount','ref','status','claimedAt']);

      // إعادة الإقرار بعد الرفض — ولا يمسّ إقرارًا مؤكَّدًا
      allow update: if isAllowed()
                    && resource.data.uid == request.auth.uid
                    && resource.data.status != 'confirmed'
                    && request.resource.data.status == 'claimed'
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.keys().hasOnly(
                         ['uid','email','name','cycle','amount','ref','status','claimedAt']);

      // المدرس يؤكّد أو يرفض أو يحذف
      allow list, update, delete: if isTeacher();
    }

    // ---------- الحضور ----------
    // الطالب يسجّل حضوره في الحصة التي *فتح المدرس* تسجيلها فقط،
    // فلا يستطيع تجميع حضور حصص فائتة لاحقًا.
    function attOpen() {
      return exists(/databases/$(database)/documents/config/attendance)
        ? get(/databases/$(database)/documents/config/attendance).data.openSession
        : '';
    }

    match /attendance/{aid} {
      allow read: if isTeacher();
      allow read: if isAllowed() && resource.data.uid == request.auth.uid;

      // إنشاء فقط — لا تعديل ولا حذف من الطالب، فالسجل غير قابل للتلاعب.
      // ولأن المعرّف = sessionId_uid، لا يمكن التسجيل مرتين لنفس الحصة.
      allow create: if isAllowed()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == mail()
                    && request.resource.data.by == 'student'
                    && request.resource.data.sessionId == attOpen()
                    && request.resource.data.keys().hasOnly(
                         ['uid','email','name','n','sessionId','at','by']);

      // المدرس يسجّل يدويًا أو يحذف
      allow write: if isTeacher();
    }

    // ---------- كل ما عدا ذلك: ممنوع ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
